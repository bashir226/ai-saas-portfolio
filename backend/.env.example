# === AI.Gen Configuration ===
# Copy this file to .env and fill in your API keys

# OpenAI API Key (Required for Text Generation)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Flask Secret Key (Required for JWT authentication)
# You can generate a random string for production
FLASK_SECRET_KEY=super-secret-ai-key-for-portfolio

# Port to run the backend on
PORT=8000
